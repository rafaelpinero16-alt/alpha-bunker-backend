# ════════════════════════════════════════════════════════════════
# ALPHA TOM VAULT — Variables de Entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# ════════════════════════════════════════════════════════════════

# ── Telegram Bot ────────────────────────────────────────────────
# Token del bot obtenido con @BotFather → /mybots → API Token
BOT_TOKEN=

# Token secreto para validar webhooks de Telegram (cualquier string largo)
# Se configura al registrar el webhook:
#   POST https://api.telegram.org/bot<TOKEN>/setWebhook
#   ?url=https://TU_BACKEND/telegram/webhook
#   &secret_token=ESTE_VALOR
TELEGRAM_SECRET_TOKEN=

# ── Admin ────────────────────────────────────────────────────────
# Telegram ID numérico del administrador maestro.
# Obtenerlo con @userinfobot o desde los logs del backend.
# NO poner el ID en el código fuente (ver sesiones anteriores).
ADMIN_TELEGRAM_ID=

# ── Base de Datos ────────────────────────────────────────────────
# Railway lo inyecta automáticamente si usas el plugin PostgreSQL.
# Para desarrollo local, usa SQLite (ver database/db.py).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Mini App ────────────────────────────────────────────────────
# URL pública del frontend en Netlify (sin slash final).
MINI_APP_URL=https://TU_APP.netlify.app

# ── Canales VIP de Telegram (IDs negativos de grupos/canales) ───
CHANNEL_SOLDIER_ID=-100XXXXXXXXXX
CHANNEL_VETERAN_ID=-100XXXXXXXXXX
CHANNEL_LEGEND_ID=-100XXXXXXXXXX
CHANNEL_ICON_LEGEND_ID=-100XXXXXXXXXX